{
  // Local host worker. `wrangler dev` runs this on workerd/Miniflare — the same
  // runtime we'll deploy to on Cloudflare. Keep this config Workers-deployable.
  "name": "sharktank-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // serve index.html for client-side routes...
    "not_found_handling": "single-page-application",
    // ...but let the Worker handle the API, realtime WS, and ops pages (otherwise SPA
    // fallback would swallow them).
    "run_worker_first": ["/api/*", "/room/*", "/docs", "/docs/*", "/openapi.json", "/status", "/status/*", "/status.json", "/audit", "/audit/*", "/audit.json", "/audit.jsonl"]
  },
  // Authoritative realtime: Room hosts one arena's sim over a WebSocket; Lobby is a
  // single presence/leaderboard aggregator (addressed by idFromName("global")).
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }]
}
