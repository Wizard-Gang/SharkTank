{
  // Local host worker. `wrangler dev` runs this on workerd/Miniflare — the same
  // runtime we'll deploy to on Cloudflare. Keep this config Workers-deployable.
  "name": "sharktank-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // serve index.html for client-side routes...
    "not_found_handling": "single-page-application",
    // ...but let the Worker handle the API (otherwise SPA fallback would swallow it).
    "run_worker_first": ["/api/*"]
  }
}
