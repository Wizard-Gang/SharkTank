{
  "name": "sharktank",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "SharkTank realtime systems workload and governed production case study.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "php:install": "node scripts/php.mjs install",
    "php:start": "node scripts/php.mjs start",
    "php:stop": "node scripts/php.mjs stop",
    "php:status": "node scripts/php.mjs status",
    "test:php": "php packages/php-runtime/bin/selftest.php",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p vendor/ModuleReact3Fiber/tsconfig.json",
    "build": "vite build",
    "check:history": "node scripts/check-history.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "verify": "npm run typecheck && npm test && npm run test:php && npm run build && npm audit --audit-level=moderate",
    "deploy:wizardgangprod": "node scripts/deploy-prod.mjs",
    "deploy:wizardgangprod:dry-run": "node scripts/deploy-prod.mjs --dry-run",
    "check:evidence": "node scripts/check-evidence.mjs",
    "dev": "wrangler dev --port 8787",
    "start": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "module-react3fiber": "file:vendor/ModuleReact3Fiber",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
