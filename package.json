{
  "name": "sharktank",
  "version": "1.3.7",
  "private": true,
  "license": "MIT",
  "description": "Realtime multiplayer SharkTank with production controls and operational evidence.",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "php:install": "node scripts/php.mjs install",
    "php:start": "node scripts/php.mjs start",
    "php:stop": "node scripts/php.mjs stop",
    "php:status": "node scripts/php.mjs status",
    "test:php": "php packages/php-runtime/bin/selftest.php",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p vendor/ModuleReact3Fiber/tsconfig.json",
    "build": "vite build",
    "check:history": "node scripts/check-history.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check": "npm run typecheck && npm test && npm run test:php && npm run build && npm run check:change-contract && npm run test:github-settings && npm run check:history && npm run check:provenance && npm run check:local-http && npm audit --audit-level=moderate && npm run check:whitespace",
    "deploy:wizardgangprod": "node scripts/deploy-prod.mjs",
    "deploy:wizardgangprod:dry-run": "node scripts/deploy-prod.mjs --dry-run",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:public-ia": "node scripts/check-public-ia.mjs",
    "dev": "wrangler dev --port 8787",
    "start": "wrangler dev --port 8787",
    "check:change-contract": "node --test scripts/change-contract-cases.mjs && node scripts/check-change-contract.mjs",
    "check:local-http": "node --test scripts/local-worker-acceptance-cases.mjs && node scripts/check-local-http.mjs --cleanup-proof && node scripts/check-local-http.mjs",
    "check:whitespace": "git diff --check HEAD^",
    "test:github-settings": "node --test scripts/github-settings-cases.mjs",
    "check:github-settings": "node scripts/check-github-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-settings.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "module-react3fiber": "file:vendor/ModuleReact3Fiber",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0"
  }
}
